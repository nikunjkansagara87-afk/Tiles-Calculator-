rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nikunj.kansagara87@gmail.com' ||
        request.auth.token.email.lower() == 'nikunj.kansagara87@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Global Brand & Studio Settings:
    // Visible to all users and clients, editable exclusively by admin nikunj.kansagara87@gmail.com
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Whitelisted admin registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
